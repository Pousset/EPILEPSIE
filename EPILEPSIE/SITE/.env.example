# .env.example

# --- Base de donnees Neon ---
# Adresse avec pooler (utilisee par l'application)
DATABASE_URL="postgresql://utilisateur:motdepasse@hote-pooler.neon.tech/neondb?sslmode=require"
# Adresse directe, sans pooler (utilisee par Prisma : migrations et Studio)
DATABASE_URL_UNPOOLED="postgresql://utilisateur:motdepasse@hote.neon.tech/neondb?sslmode=require"

# --- Better Auth ---
# Generer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
# Adresse exacte du site, port compris (ex. http://localhost:3000)
BETTER_AUTH_URL="http://localhost:3000"